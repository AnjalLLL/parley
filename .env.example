# Leave GEMINI_API_KEY empty to run in echo mode (hear yourself back) for testing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# Optional TTS
ELEVENLABS_API_KEY=your_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Pion gRPC address
PION_GRPC_URL=sfu:50051

# STUN (free, always works for testing)
STUN_SERVER=stun:stun.l.google.com:19302

# Set to true if testing behind NAT (use freestun.net for dev)
TURN_ENABLED=false
TURN_URL=turn:freestun.net:3478
TURN_USERNAME=free
TURN_CREDENTIAL=free

# Public IP Pion advertises in ICE candidates (127.0.0.1 for local docker testing)
PION_PUBLIC_IP=127.0.0.1

# --- Security & limits ---
# Comma-separated API keys for the REST API. Empty = dev mode (anyone can create calls).
VOXWIRE_API_KEYS=
# Secret that signs per-call tokens. Generate with: openssl rand -hex 32
VOXWIRE_SECRET=
# Allowed browser origins, comma-separated (e.g. https://app.example.com)
VOXWIRE_CORS_ORIGINS=*
MAX_CONCURRENT_CALLS=20
MAX_CALL_SECONDS=1800
SESSION_TTL_SECONDS=600
SESSION_CREATE_PER_MINUTE=60
# text or json
LOG_FORMAT=text
# Timeout for unary gRPC calls to the SFU (seconds)
SFU_TIMEOUT_SECONDS=5
